{
  "schemaVersion": 1,
  "appId": "memo",
  "displayName": "Mémo",
  "description": "Listes de culture générale, révision espacée et quiz du jour à barème.",
  "lifecycle": "construction",
  "ownership": {
    "audience": "single-user",
    "repositoryVisibility": "public",
    "publicUrl": "https://blinytz.github.io/memo/",
    "repository": "Blinytz/memo"
  },
  "data": {
    "storage": [
      "localStorage",
      "files"
    ],
    "exportAvailable": true,
    "productionMutationAllowed": false
  },
  "eclats": {
    "mode": "shared",
    "ledger": "canonical",
    "balanceMigration": "forbidden"
  },
  "commands": {
    "install": null,
    "dev": "node build/serve_memo.js",
    "test": "node --test \"app/tests/*.test.mjs\"",
    "build": null,
    "lint": null
  },
  "integration": {
    "contractVersion": 1,
    "status": "connected",
    "adapter": "app/js/eclats.js"
  }
}
