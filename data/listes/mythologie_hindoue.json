na","valeurs":["Krishna","Huitième avatar de Vishnou","Flûte · Peau bleue · Plume de paon","Fils de Vasudeva et Devaki"],"image":"thumbs/mythologie_hindoue/krishna.webp","grande":"full/mythologie_hindoue/krishna.webp","wiki":"https://fr.wikipedia.org/wiki/Krishna"},{"id":"kubera","valeurs":["Kubera","Dieu des richesses, roi des Yakshas","Sac de trésors · Mangouste","Demi-frère de Ravana"],"image":"thumbs/mythologie_hindoue/kubera.webp","grande":"full/mythologie_hindoue/kubera.webp","wiki":"https://fr.wikipedia.org/wiki/Kubera"},{"id":"kumbhakarna","valeurs":["Kumbhakarna","Géant rakshasa au long sommeil","Géant · Sommeil de six mois","Frère de Ravana"],"image":"thumbs/mythologie_hindoue/kumbhakarna.webp","grande":"full/mythologie_hindoue/kumbhakarna.webp","wiki":"https://fr.wikipedia.org/wiki/Kumbhakarna"},{"id":"kurma","valeurs":["Kurma","Deuxième avatar de Vishnou","Tortue · Mont Mandara","Avatar de Vishnou"],"image":"thumbs/mythologie_hindoue/kurma.webp","grande":"full/mythologie_hindoue/kurma.webp","wiki":"https://fr.wikipedia.org/wiki/K%C3%BBrma"},{"id":"lakshmana","valeurs":["Lakshmana","Frère et compagnon d'exil de Rama","Arc","Fils de Dasharatha et Sumitra"],"image":"thumbs/mythologie_hindoue/lakshmana.webp","grande":"full/mythologie_hindoue/lakshmana.webp","wiki":"https://fr.wikipedia.org/wiki/Lakshmana"},{"id":"lakshmi","valeurs":["Lakshmi","Déesse de la prospérité et de la fortune","Lotus · Pièces d'or · Éléphants","Épouse de Vishnou"],"image":"thumbs/mythologie_hindoue/lakshmi.webp","grande":"full/mythologie_hindoue/lakshmi.webp","wiki":"https://fr.wikipedia.org/wiki/Lakshmi"},{"id":"mahishasura","valeurs":["Mahishasura","Démon-buffle vaincu par Durga","Buffle","Fils du roi asura Rambha"],"image":"thumbs/mythologie_hindoue/mahishasura.webp","grande":"full/mythologie_hindoue/mahishasura.webp","wiki":"https://fr.wikipedia.org/wiki/Mahishasura"},{"id":"matsya","valeurs":["Matsya","Premier avatar de Vishnou","Poisson · Sauve Manu du déluge","Avatar de Vishno