# Secrets et réglages propres à chaque ordinateur
.env
.env.*
!.env.example
.claude/

# Caches et fichiers temporaires reconstructibles
__pycache__/
*.py[cod]
build/.cache.pkl
build/.cache_images.json
*.tmp
*.bak

# Journaux d'exécution
*.log
*.log.err
*.err

# Images haute définition conservées séparément pour le moment
full/
full_test/
originaux/

# Livrables et espaces de travail générés
outputs/
work/
assets/atelier/
atelier/exports/
backups/
data/atelier/history/
hosted-atelier/

# Copies conflictuelles créées par OneDrive
*-DESKTOP-*

# Fichiers système et éditeurs
.DS_Store
Thumbs.db
.vscode/
